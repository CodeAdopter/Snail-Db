extern fn sn_db_read_unlock(lock: **void)
extern fn sn_db_write_lock(lock: **void)
extern fn sn_db_write_unlock(lock: **void)
extern fn sn_db_wait(cond: **void, lock: **void, ms: int)
extern fn sn_db_wake(cond: **void)
